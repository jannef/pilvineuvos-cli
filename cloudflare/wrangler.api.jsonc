// Read-only HTTP API used by pnmail.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inbox",
  "main": "api-worker.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": false,
  "preview_urls": false,
  // Keep variables set in the dashboard (e.g. MAX_MESSAGE_BYTES) instead of deleting them on deploy.
  "keep_vars": true,
  "routes": [
    { "pattern": "inbox.pilvineuvos.com", "custom_domain": true },
    { "pattern": "inbox.pilvineuvos.com/api/*", "zone_name": "pilvineuvos.com" }
  ],
  "d1_databases": [
    {
      "binding": "D1_INDEX",
      "database_name": "pilvineuvos-index",
      "database_id": "e8f8f094-2fbb-4549-b9b7-479c23464119",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "R2_BUCKET", "bucket_name": "pilvineuvos-messages", "jurisdiction": "eu" }
  ],
}
